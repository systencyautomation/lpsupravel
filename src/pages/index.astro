---
import '../styles/global.css';
import '@fontsource/material-icons-round';
import '@fontsource-variable/inter';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TechSpecs from '../components/TechSpecs.astro';

import Performance from '../components/Performance.astro';
import Calculator from '../components/Calculator.astro';
import Support from '../components/Support.astro';
import SEO from '../components/SEO.astro';
---

<html lang="pt-BR" class="dark">
	<head>
        <SEO />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="bg-background-dark text-gray-100 antialiased selection:bg-primary selection:text-white">
        <Navbar />
		<Hero />
        <TechSpecs />
        <Calculator />
        <Support />
	</body>
</html>
