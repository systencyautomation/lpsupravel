---
import '../styles/global.css';
import '@fontsource/material-icons-round';
import '@fontsource-variable/inter';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TechSpecs from '../components/TechSpecs.astro';

import Performance from '../components/Performance.astro';
import Calculator from '../components/Calculator.astro';
import Support from '../components/Support.astro';
import SEO from '../components/SEO.astro';
---

<html lang="pt-BR" class="dark">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-MP3773NH');</script>
		<!-- End Google Tag Manager -->

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-16744682054"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'AW-16744682054');
		</script>

		<!-- Meta Pixel Code -->
		<script is:inline>
		!function(f,b,e,v,n,t,s)
		{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
		n.callMethod.apply(n,arguments):n.queue.push(arguments)};
		if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
		n.queue=[];t=b.createElement(e);t.async=!0;
		t.src=v;s=b.getElementsByTagName(e)[0];
		s.parentNode.insertBefore(t,s)}(window, document,'script',
		'https://connect.facebook.net/en_US/fbevents.js');
		fbq('init', '1317057059673525');
		fbq('track', 'PageView');
		</script>
		<noscript><img height="1" width="1" style="display:none"
		src="https://www.facebook.com/tr?id=1317057059673525&ev=PageView&noscript=1"
		/></noscript>
		<!-- End Meta Pixel Code -->
        <SEO />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="bg-background-dark text-gray-100 antialiased selection:bg-primary selection:text-white" style="font-size: 0px; color: transparent; min-height: 100vh;">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MP3773NH"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
        
        <!-- App Wrapper to reset font settings for actual components -->
        <div id="app-wrapper" style="font-size: 16px; color: #f3f4f6; line-height: 1.5;">
            <Navbar />
            <Hero />
            <TechSpecs />
            <Calculator />
            <Support />
        </div>

        <!-- GHL Chat Widget -->
        <script 
            src="https://beta.leadconnectorhq.com/loader.js"  
            data-resources-url="https://beta.leadconnectorhq.com/chat-widget/loader.js" 
            data-widget-id="69960383f3036723ce5e73e2">
        </script>
        <!-- Cleanup stray GTM text nodes -->
        <script is:inline>
            // Remove errant G- text nodes sometimes injected by misconfigured GTM scripts
            document.addEventListener('DOMContentLoaded', () => {
                const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
                const nodesToRemove = [];
                let node;
                while (node = walk.nextNode()) {
                    if (node.nodeValue && node.nodeValue.trim().startsWith('G-')) {
                        nodesToRemove.push(node);
                    }
                }
                nodesToRemove.forEach(n => n.remove());
            });
        </script>
	</body>
</html>
