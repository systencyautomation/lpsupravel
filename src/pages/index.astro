---
import '../styles/global.css';
import '@fontsource/material-icons-round';
import '@fontsource-variable/inter';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TechSpecs from '../components/TechSpecs.astro';

import Performance from '../components/Performance.astro';
import Calculator from '../components/Calculator.astro';
import Support from '../components/Support.astro';
import SEO from '../components/SEO.astro';
---

<html lang="pt-BR" class="dark">
	<head>
		<!-- Google Tag Manager -->
		<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-MP3773NH');</script>
		<!-- End Google Tag Manager -->
        <SEO />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="bg-background-dark text-gray-100 antialiased selection:bg-primary selection:text-white">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MP3773NH"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
        <Navbar />
		<Hero />
        <TechSpecs />
        <Calculator />
        <Support />
        <!-- GHL Chat Widget -->
        <script 
            src="https://beta.leadconnectorhq.com/loader.js"  
            data-resources-url="https://beta.leadconnectorhq.com/chat-widget/loader.js" 
            data-widget-id="69960383f3036723ce5e73e2">
        </script>
	</body>
</html>
