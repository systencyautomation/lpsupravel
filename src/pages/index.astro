---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Hero2 from '../components/Hero2.astro';
import Performance from '../components/Performance.astro';
import Calculator from '../components/Calculator.astro';
import Support from '../components/Support.astro';
import SEO from '../components/SEO.astro';
---

<html lang="pt-BR" class="dark">
	<head>
        <SEO />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	</head>
	<body class="bg-background-dark text-gray-100 antialiased selection:bg-primary selection:text-white">
        <Navbar />
		<Hero />
        <Hero2 />
        <Performance />
        <Calculator />
        <Support />
        
        <!-- Non-blocking font loading via JS -->
        <script is:inline>
            (function() {
                var fonts = [
                    'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap',
                    'https://fonts.googleapis.com/icon?family=Material+Icons+Round'
                ];
                fonts.forEach(function(href) {
                    var link = document.createElement('link');
                    link.rel = 'stylesheet';
                    link.href = href;
                    document.head.appendChild(link);
                });
            })();
        </script>
        <noscript>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
            <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
        </noscript>
	</body>
</html>
