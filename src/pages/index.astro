---
import '../styles/global.css';
import '@fontsource/material-icons-round';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Hero2 from '../components/Hero2.astro';
import Performance from '../components/Performance.astro';
import Calculator from '../components/Calculator.astro';
import Support from '../components/Support.astro';
import SEO from '../components/SEO.astro';
---

<html lang="pt-BR" class="dark">
	<head>
        <SEO />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-background-dark text-gray-100 antialiased selection:bg-primary selection:text-white">
        <Navbar />
		<Hero />
        <Hero2 />
        <Performance />
        <Calculator />
        <Support />
	</body>
</html>
