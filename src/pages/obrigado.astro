        <title>Obrigado | Supravel Tría</title>
	</head>
	<body class="bg-background-dark text-gray-100 antialiased selection:bg-primary selection:text-white flex flex-col min-h-screen">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MP3773NH"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
        
        <Navbar />
        
        <main class="flex-grow flex items-center justify-center relative overflow-hidden py-24 px-4">
            <!-- Background Elements -->
            <div class="absolute inset-0 z-0">
                <div class="absolute inset-0 bg-[#0a0a0a]"></div>
                <div class="absolute inset-0 bg-gradient-to-br from-black via-black to-[#0a1a12]"></div>
                <!-- Industrial grid -->
                <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)] opacity-30"></div>
            </div>

            <div class="relative z-10 max-w-2xl w-full">
                <!-- Inner Card Container -->
                <div class="p-[1px] rounded-2xl bg-gradient-to-b from-white/10 to-transparent shadow-2xl backdrop-blur-sm">
                    <div class="bg-black/80 rounded-2xl p-8 md:p-16 border border-white/5 text-center flex flex-col items-center">
                        
                        <!-- Success Icon Container -->
                        <div class="relative w-24 h-24 mb-8">
                            <div class="absolute inset-0 bg-emerald-500/20 rounded-full blur-xl animate-pulse"></div>
                            <div class="relative w-full h-full bg-gradient-to-br from-emerald-500/20 to-emerald-900/50 border border-emerald-500/30 rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(16,185,129,0.2)]">
                                <span class="material-symbols-outlined text-5xl text-emerald-400">check_circle</span>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="space-y-4 mb-10">
                            <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">
                                Tudo Certo!
                            </h1>
                            <p class="text-xl text-gray-300 font-light max-w-md mx-auto leading-relaxed">
                                Recebemos suas informações com sucesso! Nossa equipe entrará em contato em breve de forma <strong class="text-emerald-400 font-medium">rápida e precisa</strong>.
                            </p>
                        </div>

                        <!-- Info Box -->
                        <div class="bg-white/5 border border-white/10 rounded-xl p-5 mb-10 text-left w-full max-w-sm flex items-start gap-4 mx-auto">
                            <span class="material-symbols-outlined text-primary text-2xl shrink-0">support_agent</span>
                            <div>
                                <h3 class="text-white font-medium mb-1">Atendimento Imediato</h3>
                                <p class="text-sm text-gray-400">Se preferir agilizar, clique abaixo para falar diretamente com nossa engenharia via WhatsApp.</p>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <a href="https://wa.me/555499164669" target="_blank" rel="noopener noreferrer" class="group relative inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-red-600 shadow-lg shadow-primary/20 text-white font-bold rounded-lg transition-all duration-300 border border-primary/20 overflow-hidden min-w-[200px]">
                            <!-- Hover Effect Gradient -->
                            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out"></div>
                            <span class="relative flex items-center gap-2">
                                <svg fill="currentColor" height="20" viewBox="0 0 24 24" width="20"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.696c1.029.575 2.035.894 3.213.894 3.182 0 5.769-2.587 5.769-5.766.001-3.18-2.585-5.766-5.768-5.766zm.92 7.824c-1.547.789-2.545.275-3.085-.172-.519-.43-1.637-1.485-2.036-2.584-.213-.588-.06-1.129.215-1.58.196-.32.427-.428.57-.428.18 0 .285.006.409.006.155 0 .299.04.449.363.176.38.584 1.419.637 1.522.053.102.089.222.018.361-.071.14-.106.227-.213.348-.106.12-.224.269-.32.362-.107.103-.217.215-.094.425.124.211.546.895 1.171 1.45.626.557 1.154.729 1.401.834.195.083.333.067.452-.072.16-.186.671-.777.85-1.042.179-.264.356-.219.596-.131.24.089 1.517.712 1.777.84.26.128.433.192.496.299.062.107.062.62-.213 1.396zm11.049-5.824c0 6.627-5.373 12-12 12-6.627 0-12-5.373-12-12s5.373-12 12-12 12 5.373 12 12zm-2.186 0c0-5.42-4.394-9.814-9.814-9.814-5.42 0-9.814 4.394-9.814 9.814 0 5.42 4.394 9.814 9.814 9.814 5.42 0 9.814-4.394 9.814-9.814z"></path></svg>
                                Falar no WhatsApp Agora
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </main>
        
        <!-- Footer -->
        <footer class="mt-auto border-t border-white/5 bg-black py-8 relative z-10 w-full text-center">
             <p class="text-sm text-gray-500">© 2026 Supravel. Todos os direitos reservados.</p>
        </footer>
	</body>
</html>
