                    </a>
                </div>
            </div>
            <!-- Links Column 1 -->
            <div>
                <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-6">Produtos</h4>
                <ul class="space-y-4">
                    <li><a class="text-sm text-gray-400 hover:text-primary transition-colors" href="https://wa.me/555499164669?text=Gostaria%20de%20saber%20sobre%20Empilhadeira%20S%C3%A9rie%20X" target="_blank" rel="noopener noreferrer">Empilhadeira Série X</a></li>
