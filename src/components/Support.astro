---
---

<section id="suporte" class="relative py-24 px-6 overflow-hidden border-t border-white/5">
    <!-- Abstract Glow Background -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/10 blur-[120px] rounded-full pointer-events-none translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-blue-500/5 blur-[100px] rounded-full pointer-events-none -translate-x-1/3 translate-y-1/3"></div>

    <div class="relative z-10 max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-20 max-w-3xl">
            <span class="inline-block py-1 px-3 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold tracking-widest uppercase mb-4">
                Engenharia de Confiabilidade
            </span>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-white mb-6">
                Performance Vitalícia.<br/><span class="text-gray-500">Precisão Garantida.</span>
            </h2>
            <p class="text-lg text-gray-400 max-w-xl leading-relaxed">
                Nosso compromisso vai muito além da entrega. Experimente um ecossistema de manutenção projetado para zero inatividade e máxima eficiência do lítio.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
            <!-- Left Column: Timeline -->
            <div class="lg:col-span-7">
                <h3 class="text-sm font-mono text-gray-500 uppercase tracking-wider mb-10 pl-12 border-l border-transparent">Roteiro Preventivo</h3>
                <div class="relative space-y-12">
                    <!-- Vertical Line -->
                    <div class="absolute left-[19px] top-2 bottom-2 w-[1px] timeline-line bg-gray-800"></div>
                    
                    <!-- Step 1 -->
                    <div class="relative flex items-start group">
                        <div class="relative z-10 flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-background-dark border border-gray-700 group-hover:border-gray-500 transition-colors">
                            <span class="block w-2.5 h-2.5 rounded-full bg-gray-500"></span>
                        </div>
                        <div class="ml-8 pt-1">
                            <div class="flex items-baseline justify-between mb-1">
                                <h4 class="text-lg font-medium text-white">Entrega e Calibração</h4>
                                <span class="text-xs font-mono text-gray-500">Mês 0</span>
                            </div>
                            <p class="text-sm text-gray-400">Configuração inicial dos parâmetros de lítio adaptados ao fluxo do seu armazém. Treinamento de operadores incluído.</p>
                        </div>
                    </div>

                    <!-- Step 2 (Active/Glowing) -->
                    <div class="relative flex items-start group">
                        <div class="relative z-10 flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-background-dark border border-primary transition-colors glow-point shadow-[0_0_15px_2px_rgba(234,42,51,0.5)]">
                            <span class="block w-2.5 h-2.5 rounded-full bg-primary"></span>
                        </div>
                        <div class="ml-8 pt-1">
                            <div class="flex items-baseline justify-between mb-1">
                                <h4 class="text-lg font-medium text-white">Primeiro Diagnóstico</h4>
                                <span class="text-xs font-mono text-primary">500 Horas</span>
                            </div>
                            <p class="text-sm text-gray-400">Análise remota de telemetria e inspeção in loco dos sistemas hidráulicos e BMS (Sistema de Gerenciamento de Bateria).</p>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative flex items-start group">
                        <div class="relative z-10 flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-background-dark border border-gray-700 group-hover:border-gray-500 transition-colors">
                            <span class="block w-2.5 h-2.5 rounded-full bg-gray-500"></span>
                        </div>
                        <div class="ml-8 pt-1">
                            <div class="flex items-baseline justify-between mb-1">
                                <h4 class="text-lg font-medium text-white">Otimização de Ciclo Completo</h4>
                                <span class="text-xs font-mono text-gray-500">Ano 1</span>
                            </div>
                            <p class="text-sm text-gray-400">Auditoria completa de hardware e atualizações de firmware para garantir eficiência máxima de torque.</p>
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="relative flex items-start group">
                        <div class="relative z-10 flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-background-dark border border-gray-700 group-hover:border-gray-500 transition-colors">
                            <span class="block w-2.5 h-2.5 rounded-full bg-gray-500"></span>
                        </div>
                        <div class="ml-8 pt-1">
                            <div class="flex items-baseline justify-between mb-1">
                                <h4 class="text-lg font-medium text-white">Revisão Geral e Saúde da Bateria</h4>
                                <span class="text-xs font-mono text-gray-500">Ano 5</span>
                            </div>
                            <p class="text-sm text-gray-400">Análise profunda de componentes de desgaste mecânico e certificação detalhada da saúde das células da bateria.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Warranty Seal & perks -->
            <div class="lg:col-span-5 flex flex-col space-y-8">
                <!-- Warranty Card -->
                <div class="glass-nav rounded-xl p-8 relative overflow-hidden group border border-white/10">
                    <!-- Gradient shine effect on hover -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-white/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 ease-in-out"></div>
                    <div class="flex flex-col items-center text-center">
                        <!-- Metallic Seal Graphic -->
                        <div class="w-40 h-40 rounded-full bg-gradient-to-br from-[#f0f0f0] via-[#5c5c5c] to-[#1a1a1a] p-[1px] mb-6 shadow-2xl relative">
                            <div class="w-full h-full rounded-full bg-gradient-to-br from-[#2a2a2a] to-[#000000] flex items-center justify-center relative overflow-hidden">
                                <!-- Metallic shine inside -->
                                <div class="absolute top-0 left-0 w-full h-full opacity-20 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMDUiLz4KPC9zdmc+')]"></div>
                                <div class="text-center z-10">
                                    <div class="text-[10px] uppercase tracking-[0.2em] text-gray-400 mb-1">Certificado Tría</div>
                                    <div class="text-3xl font-bold bg-gradient-to-b from-white to-gray-400 bg-clip-text text-transparent leading-none">5 ANOS</div>
                                    <div class="text-[10px] font-mono text-primary mt-1">GARANTIA LÍTIO</div>
                                </div>
                                <!-- Inner Ring -->
                                <div class="absolute inset-2 rounded-full border border-white/10"></div>
                            </div>
                        </div>
                        <h3 class="text-xl font-semibold text-white mb-2">Proteção Blindada</h3>
                        <p class="text-sm text-gray-400 leading-relaxed">
                            Nossas baterias de Íon-Lítio são garantidas por 5 anos de performance abrangente. Sem letras miúdas, apenas potência.
                        </p>
                    </div>
                </div>

                <!-- Service Perks Grid -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="glass-nav p-4 rounded-lg flex flex-col items-start hover:bg-white/5 transition-colors cursor-default border border-white/5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 mb-3 w-6 h-6"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span class="text-sm font-medium text-white leading-tight">Atendimento em 48h <br><span class="text-[10px] text-gray-500 font-normal">(raio 100km)</span></span>
                    </div>
                    <div class="glass-nav p-4 rounded-lg flex flex-col items-start hover:bg-white/5 transition-colors cursor-default border border-white/5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 mb-3 w-6 h-6"><path d="m14 18-1 4"/><path d="m10 18 1 4"/><path d="m5 10 3 3"/><path d="M17 14V8c0-2-1-3-3-3h-4C8 5 7 6 7 8v6l-2 2v2h14v-2l-2-2Z"/><path d="m19 10-3 3"/><path d="m12 2v2"/></svg>
                        <span class="text-sm font-medium text-white">Peças Originais</span>
                    </div>
                    <div class="glass-nav p-4 rounded-lg flex flex-col items-start hover:bg-white/5 transition-colors cursor-default border border-white/5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 mb-3 w-6 h-6"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                        <span class="text-sm font-medium text-white">Manutenção Simplificada</span>
                    </div>
                    <div class="glass-nav p-4 rounded-lg flex flex-col items-start hover:bg-white/5 transition-colors cursor-default border border-white/5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 mb-3 w-6 h-6"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5"/><path d="M14 17h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                        <span class="text-sm font-medium text-white">Reparo no Local</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer Section -->
<footer class="bg-[#050505] border-t border-white/5 pt-20 pb-10 px-6 relative overflow-hidden">
    <!-- Decoration -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-[1px] bg-gradient-to-r from-transparent via-primary/40 to-transparent"></div>
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-16">
            <!-- Brand Column -->
            <div class="col-span-1 lg:col-span-1">
                <div class="flex items-center gap-2 mb-6">
                    <!-- Logo Image -->
                    <img src="/logo.webp" alt="Supravael Tría" class="h-10 w-auto opacity-80" />
                </div>
                <p class="text-sm text-gray-500 leading-relaxed mb-6">
                    Redefinindo a movimentação de materiais com engenharia de precisão e tecnologia avançada de lítio.
