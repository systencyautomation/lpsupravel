---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-tria.webp';
---

<section id="empilhadeiras" class="relative min-h-screen flex flex-col justify-center overflow-hidden">
  <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.15] bg-grid-pattern"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] hero-glow pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 font-display pt-32 md:pt-40 text-center">
    <!-- Static Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold uppercase tracking-wider mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        Nova Série Lítio 2026
    </div>

    <!-- Static Heading (Critical for FCP) -->
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-[1.1] max-w-4xl mx-auto">
        <span class="text-gradient block">Empilhadeiras Elétricas a Lítio</span>
        <span class="text-white relative inline-block text-3xl md:text-5xl mt-2">
            Reduza Custos Operacionais em até 84%
            <svg class="absolute w-full h-3 -bottom-1 left-0 text-primary opacity-80" fill="none" viewBox="0 0 200 9" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.00025 6.99997C25.7265 0.386001 81.6543 -2.25997 127.323 2.08331C152.091 4.43936 177.306 6.58667 197.989 6.99998" stroke="currentColor" stroke-linecap="round" stroke-width="3"></path>
            </svg>
        </span>
    </h1>

    <!-- Static Paragraph -->
    <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed mb-10 font-light">
        Líder em tecnologia de Lítio no Rio Grande do Sul. Logística inteligência.
    </p>


  </div>

  <!-- Static Image & Hotspots - Critical for LCP -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 mt-10 mb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[30px] items-center w-full">
        <!-- Esquerda (Cards 33%) - REMOVIDO -->


        <!-- Imagem Esquerda -->
        <div class="lg:col-span-7 relative group w-full px-0 order-2 lg:order-1 mt-10 lg:mt-0">
            <div class="relative group w-full">
        <div class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl bg-[#0a0a0a] flex items-center justify-center">
            <Image
                src={heroImage}
                alt="Empilhadeiras elétricas a lítio Supravel - Líder no Rio Grande do Sul"
                class="w-full h-full object-contain !h-full !object-contain"
                sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background-dark via-transparent to-transparent opacity-60"></div>

            <!-- Hotspots Container -->
            <div class="absolute inset-0 z-20">
                <!-- Hotspot 3 (Altura) -->
                <div class="absolute top-[35%] left-[37%] hotspot-group group/h3">
                    <div class="relative w-8 h-8 cursor-pointer">
                        <div class="absolute inset-0 rounded-full bg-amber-400/40 animate-ping"></div>
                        <div class="relative w-full h-full bg-amber-500 rounded-full flex items-center justify-center shadow-lg border-2 border-white/20">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white">
                                <path d="M12 20V4" />
                                <path d="m5 11 7-7 7 7" />
                            </svg>
                        </div>
                    </div>
                    <div class="hotspot-card absolute bottom-12 left-1/2 -translate-x-1/2 w-64 p-3 rounded-2xl border border-white/10 opacity-0 -translate-y-4 scale-95 transition-all duration-300 pointer-events-none z-30 shadow-2xl group-hover/h3:opacity-100 group-hover/h3:translate-y-0 group-hover/h3:scale-100 group-hover/h3:pointer-events-auto bg-black/80 backdrop-blur-md">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="p-1.5 bg-amber-500/20 rounded-lg text-amber-500">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                                    <path d="M12 20V4" />
                                    <path d="m5 11 7-7 7 7" />
                                </svg>
                            </div>
                            <span class="text-xs font-bold text-white">Alcance Vertical</span>
                        </div>
                        <p class="text-lg font-bold text-white mb-0.5">Altura de Elevação</p>
                        <p class="text-xl font-bold text-amber-500 mb-2">4,8 a 6 m</p>
                        <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                            <div class="bg-amber-500 h-full w-[80%]"></div>
                        </div>
                    </div>
                </div>

                <!-- Hotspot 1 -->
                <div class="absolute top-[70%] left-[22%] hotspot-group group/h1">
                    <div class="relative w-8 h-8 cursor-pointer">
                        <div class="absolute inset-0 rounded-full bg-primary/40 animate-ping"></div>
                        <div class="relative w-full h-full bg-primary rounded-full flex items-center justify-center shadow-lg border-2 border-white/20">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white">
                                <path d="M12 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                <path d="M6.835 9h10.33a1 1 0 0 1 .984 .821l1.637 9a1 1 0 0 1 -.984 1.179h-13.604a1 1 0 0 1 -.984 -1.179l1.637 -9a1 1 0 0 1 .984 -.821z" />
                            </svg>
                        </div>
                    </div>
                    <div class="hotspot-card absolute bottom-12 left-1/2 -translate-x-1/2 w-64 p-3 rounded-2xl border border-white/10 opacity-0 -translate-y-4 scale-95 transition-all duration-300 pointer-events-none z-30 shadow-2xl group-hover/h1:opacity-100 group-hover/h1:translate-y-0 group-hover/h1:scale-100 group-hover/h1:pointer-events-auto bg-black/80 backdrop-blur-md">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="p-1.5 bg-primary/20 rounded-lg text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                                    <path d="M12 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                    <path d="M6.835 9h10.33a1 1 0 0 1 .984 .821l1.637 9a1 1 0 0 1 -.984 1.179h-13.604a1 1 0 0 1 -.984 -1.179l1.637 -9a1 1 0 0 1 .984 -.821z" />
                                </svg>
                            </div>
                            <span class="text-xs font-bold text-white">Capacidade de Carga</span>
                        </div>
                        <p class="text-lg font-bold text-white mb-0.5">EFX 302</p>
                        <p class="text-xl font-bold text-primary mb-2">3,0 TON</p>
                        <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                            <div class="bg-primary h-full w-[100%]"></div>
                        </div>
                        <div class="mt-2 text-[10px] text-gray-500 font-medium uppercase tracking-wider">Alta Performance</div>
                    </div>
                </div>

                <!-- Hotspot 2 -->
                <div class="absolute top-[60%] left-[65%] hotspot-group group/h2">
                    <div class="relative w-8 h-8 cursor-pointer">
                        <div class="absolute inset-0 rounded-full bg-green-400/40 animate-ping"></div>
                        <div class="relative w-full h-full bg-green-500 rounded-full flex items-center justify-center shadow-lg border-2 border-white/20">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white">
                                <path d="M15 7h1a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-2"/>
                                <path d="M6 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h1"/>
                                <path d="m11 7-3 5h4l-3 5"/>
                                <line x1="22" x2="22" y1="11" y2="13"/>
                            </svg>
                        </div>
                    </div>
                    <div class="hotspot-card absolute bottom-12 left-1/2 -translate-x-1/2 w-64 p-3 rounded-2xl border border-white/10 opacity-0 -translate-y-4 scale-95 transition-all duration-300 pointer-events-none z-30 shadow-2xl group-hover/h2:opacity-100 group-hover/h2:translate-y-0 group-hover/h2:scale-100 group-hover/h2:pointer-events-auto bg-black/80 backdrop-blur-md">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="p-1.5 bg-green-500/20 rounded-lg text-green-400">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white">
                                    <path d="M15 7h1a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-2"/>
                                    <path d="M6 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h1"/>
                                    <path d="m11 7-3 5h4l-3 5"/>
                                    <line x1="22" x2="22" y1="11" y2="13"/>
                                </svg>
                            </div>
                            <span class="text-xs font-bold text-white">Bateria Removível 80V</span>
                        </div>
                        <p class="text-xs text-gray-400 leading-relaxed mb-1">
                            Equipado com bateria de íons de lítio 80V/150Ah como padrão.
                        </p>
                        <p class="text-xs text-gray-500 leading-relaxed">
                            Zero manutenção e fácil extração lateral para operação contínua.
                        </p>
                    </div>
                </div>
                <!-- Hotspot 4 (Pneus) --> 
                <div class="absolute top-[75%] left-[50%] hotspot-group group/h4">
                    <div class="relative w-8 h-8 cursor-pointer">
                        <div class="absolute inset-0 rounded-full bg-gray-400/40 animate-ping"></div>
                        <div class="relative w-full h-full bg-gray-500 rounded-full flex items-center justify-center shadow-lg border-2 border-white/20">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white">
                                <circle cx="12" cy="12" r="10"/>
                                <circle cx="12" cy="12" r="4"/>
                            </svg>
                        </div>
                    </div>
                    <div class="hotspot-card absolute bottom-12 left-full ml-4 w-64 p-3 rounded-2xl border border-white/10 opacity-0 transition-all duration-300 pointer-events-none z-30 shadow-2xl group-hover/h4:opacity-100 group-hover/h4:pointer-events-auto bg-black/80 backdrop-blur-md origin-bottom-left">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="p-1.5 bg-gray-500/20 rounded-lg text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                                    <circle cx="12" cy="12" r="10"/>
                                    <circle cx="12" cy="12" r="4"/>
                                    <path d="M12 2a10 10 0 0 1 10 10"/>
                                </svg>
                            </div>
                            <span class="text-xs font-bold text-white">Versatilidade</span>
                        </div>
                        <p class="text-[10px] uppercase font-bold text-gray-500 tracking-wider mb-0.5">Tipo de Rodado</p>
                        <p class="text-lg font-bold text-white mb-2 leading-tight">Pneu Maciço ou Pneumático</p>
                        <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                            <div class="bg-gray-500 h-full w-[100%]"></div>
                        </div>
                        <div class="mt-2 text-[10px] text-gray-400 font-medium">Adaptável ao seu terreno</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        </div>

        <!-- Formulário Direita -->
        <div class="lg:col-span-5 relative w-full order-1 lg:order-2">
            <div class="glass-card rounded-3xl p-6 md:p-8 relative overflow-hidden backdrop-blur-xl bg-[#0a0a0a]/80 border border-white/10 shadow-2xl flex flex-col">
                <div class="absolute -top-40 -right-40 w-96 h-96 bg-primary/20 blur-[120px] rounded-full pointer-events-none z-0"></div>
                <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none z-0"></div>
                
                <div class="relative z-10 mb-6 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-gray-300 text-[10px] font-semibold uppercase tracking-wider mb-4">
                        <span class="material-symbols-outlined text-[14px] text-primary">speed</span>
                        Resposta em 15 minutos
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2">Solicite um Orçamento</h3>
                    <p class="text-sm text-gray-400">Preencha seus dados para conversarmos sobre a sua operação e gerar uma cotação exata.</p>
                </div>

                <div class="relative w-full z-10">
                    <iframe
                        src="https://links.kordian.com.br/widget/form/VI0BjQ56e3YSBb36HNJf"
                        style="width:100%;height:100%;border:none;border-radius:3px"
                        id="inline-VI0BjQ56e3YSBb36HNJf" 
                        data-layout="{'id':'INLINE'}"
                        data-trigger-type="alwaysShow"
                        data-trigger-value=""
                        data-activation-type="alwaysActivated"
                        data-activation-value=""
                        data-deactivation-type="neverDeactivate"
                        data-deactivation-value=""
                        data-form-name="Form LP - hero"
                        data-height="undefined"
                        data-layout-iframe-id="inline-VI0BjQ56e3YSBb36HNJf"
                        data-form-id="VI0BjQ56e3YSBb36HNJf"
                        title="Form LP - hero"
                            >
                    </iframe>
                    <script is:inline src="https://links.kordian.com.br/js/form_embed.js"></script>
                </div>
            </div>
        </div>
    </div>


  </div>
</section>
