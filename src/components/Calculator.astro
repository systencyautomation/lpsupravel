---
---

<section class="relative py-20 px-4 sm:px-6 relative overflow-hidden bg-background-dark text-gray-200 font-display flex flex-col items-center justify-center">
    
    <!-- Background Effects -->
    <div class="absolute top-0 left-1/4 w-[600px] h-[400px] bg-primary/5 blur-[100px] rounded-full pointer-events-none z-0"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[300px] bg-emerald-500/5 blur-[80px] rounded-full pointer-events-none z-0"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full h-full flex flex-col">
        <!-- Header -->
        <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/5 pb-4">
            <div>
                <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
                    Calculadora de Eficiência
                </h2>
                <p class="text-sm text-gray-400 font-light mt-1">
                    Compare sua operação atual com a tecnologia Lítio EFX.
                </p>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500 bg-white/5 px-3 py-1 rounded border border-white/5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Dados atualizados: 2024
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 h-full items-start">
            
            <!-- Left Column: Controls -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                <div class="glass-panel rounded-xl p-6 md:p-8 border-l-4 border-l-gray-600 flex flex-col bg-white/5 backdrop-blur-md border border-white/10">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-sm font-semibold uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <span class="material-symbols-outlined text-lg">tune</span>
                            Painel de Controle
                        </h3>
                    </div>

                    <div class="space-y-8">
                        <!-- Fuel Type -->
                        <div>
                            <label class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-2 block">Combustível Atual</label>
                            <div id="fuel-selector" class="grid grid-cols-2 gap-2 p-1 bg-black/40 rounded-lg border border-white/10">
                                <button data-fuel="diesel" class="fuel-btn relative py-2.5 text-sm font-medium rounded bg-white/10 text-white shadow-sm transition-all flex items-center justify-center gap-2 group border border-white/5 active">
                                    <span class="material-symbols-outlined text-gray-400 text-sm group-hover:text-white">local_gas_station</span>
                                    Diesel
                                </button>
                                <button data-fuel="glp" class="fuel-btn relative py-2.5 text-sm font-medium rounded text-gray-400 hover:text-white hover:bg-white/5 transition-all flex items-center justify-center gap-2 border border-transparent">
                                    <span class="material-symbols-outlined text-gray-500 text-sm">propane</span>
                                    GLP
                                </button>
                            </div>
                        </div>

                        <!-- Quantity -->
                        <div>
                            <div class="flex justify-between items-end mb-2">
                                <label class="text-xs text-gray-500 uppercase tracking-wide font-medium">Quantidade de Máquinas</label>
                            </div>
                            
                            <!-- Stepper Control -->
                            <div class="flex items-center justify-between gap-2 mb-3 p-1 bg-black/40 rounded-lg border border-white/10 max-w-[200px] mx-auto">
                                <button id="qty-minus" class="w-8 h-8 flex items-center justify-center rounded bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white transition-all border border-white/5 active:scale-95">
                                    <span class="material-symbols-outlined text-sm">remove</span>
                                </button>
                                <div class="flex-grow text-center">
                                    <span id="qty-display" class="text-xl font-bold text-white font-mono tracking-wider">10</span>
                                </div>
                                <button id="qty-plus" class="w-8 h-8 flex items-center justify-center rounded bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 hover:text-emerald-300 transition-all border border-emerald-500/30 active:scale-95 shadow-[0_0_15px_rgba(16,185,129,0.1)]">
                                    <span class="material-symbols-outlined text-sm">add</span>
                                </button>
                            </div>

                            <!-- Presets -->
                            <div id="qty-selector" class="grid grid-cols-5 gap-2">
                                <button data-qty="1" class="qty-btn chip-option w-full h-10 flex items-center justify-center rounded border border-white/10 bg-white/5 text-sm font-mono text-gray-400 transition-all hover:bg-white/10 hover:border-white/20">1</button>
                                <button data-qty="3" class="qty-btn chip-option w-full h-10 flex items-center justify-center rounded border border-white/10 bg-white/5 text-sm font-mono text-gray-400 transition-all hover:bg-white/10 hover:border-white/20">3</button>
                                <button data-qty="5" class="qty-btn chip-option w-full h-10 flex items-center justify-center rounded border border-white/10 bg-white/5 text-sm font-mono text-gray-400 transition-all hover:bg-white/10 hover:border-white/20">5</button>
                                <button data-qty="10" class="qty-btn chip-option active w-full h-10 flex items-center justify-center rounded border border-primary bg-primary/20 text-sm font-mono text-white transition-all shadow-[0_0_5px_rgba(237,28,36,0.3)]">10</button>
                                <button data-qty="20" class="qty-btn chip-option w-full h-10 flex items-center justify-center rounded border border-white/10 bg-white/5 text-sm font-mono text-gray-400 transition-all hover:bg-white/10 hover:border-white/20">20</button>
                            </div>
                        </div>

                        <!-- Shifts -->
                        <div>
                            <div class="flex justify-between items-end mb-2">
                                <label class="text-xs text-gray-500 uppercase tracking-wide font-medium">Horas de Operação</label>
                            </div>
                            <div id="shift-selector" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                <button data-shift="1" class="shift-btn active shift-chip py-3 px-3 rounded text-left flex flex-col justify-center bg-emerald-500/10 border border-emerald-500 text-white">
                                    <span class="text-[10px] uppercase text-emerald-400 font-bold tracking-wider mb-0.5">1 Turno</span>
                                    <span class="text-sm font-mono text-white">6h / dia</span>
                                </button>
                                <button data-shift="2" class="shift-btn shift-chip py-3 px-3 rounded text-left flex flex-col justify-center text-gray-400 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all">
                                    <span class="text-[10px] uppercase text-gray-500 font-bold tracking-wider mb-0.5">2 Turnos</span>
                                    <span class="text-sm font-mono">12h / dia</span>
                                </button>
                                <button data-shift="3" class="shift-btn shift-chip py-3 px-3 rounded text-left flex flex-col justify-center text-gray-400 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all">
                                    <span class="text-[10px] uppercase text-gray-500 font-bold tracking-wider mb-0.5">Fluxo Contínuo</span>
                                    <span class="text-sm font-mono">18h / dia</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Results -->
            <div class="lg:col-span-5 flex flex-col h-full">
                <div class="glass-panel rounded-xl border-l-4 border-l-emerald-500 p-6 md:p-8 flex flex-col justify-between relative overflow-hidden shadow-2xl h-full bg-white/5 backdrop-blur-md border border-white/10">
                    <div class="absolute -top-20 -right-20 w-64 h-64 bg-emerald-500/10 blur-[80px] rounded-full pointer-events-none"></div>
                    
                    <div class="relative z-10 flex flex-col h-full">
                        <div class="flex items-center gap-2 mb-6">
                            <span class="material-symbols-outlined text-emerald-500">savings</span>
                            <span class="text-xs font-bold uppercase tracking-widest text-emerald-500">Painel de Resultados</span>
                        </div>
                        
                        <div class="space-y-1 mb-8">
                            <span class="block text-sm text-gray-400 font-light">Economia Anual Estimada</span>
                            <h1 id="annual-savings" class="text-5xl lg:text-6xl font-bold text-emerald-400 tracking-tight leading-none drop-shadow-[0_0_8px_rgba(16,185,129,0.3)]">
                                ± R$ 345k
                            </h1>
                            <div class="flex items-center gap-2 mt-3">
                                <span id="efficiency-badge" class="px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs font-bold">
                                    +84% Eficiência
                                </span>
                                <span id="comparison-label" class="text-xs text-gray-500">vs. Diesel (10 un / 6h)</span>
                            </div>
                            <p class="text-[10px] text-gray-500 mt-2 font-light">
                                * Valores aproximados. A economia real pode variar de acordo com a sua operação.
                            </p>
                        </div>
                        
                        <div class="mb-8 pt-6 border-t border-white/5">
                            <div class="flex justify-between items-end mb-2">
                                <span class="text-sm text-gray-400">Projeção 5 Anos</span>
                                <span id="projection-5y" class="text-xl font-bold text-white font-mono">R$ 1.725.000</span>
                            </div>
                            <div class="w-full bg-gray-800 rounded-full h-1.5 overflow-hidden">
                                <div id="projection-bar" class="bg-emerald-500 h-full rounded-full shadow-[0_0_10px_rgba(16,185,129,0.5)] transition-all duration-500" style="width: 84%"></div>
                            </div>
                        </div>
                        
                        <div class="mb-6 bg-black/20 rounded-lg p-4 border border-white/5 flex-grow">
                            <div class="flex justify-between items-center mb-3">
                                <span class="text-[10px] uppercase text-gray-500 font-bold tracking-wider">Comparativo de Custos (Ano 1)</span>
                            </div>
                            <div class="space-y-4">
                                <div>
                                    <div class="flex justify-between text-xs mb-1">
                                        <span class="text-gray-400">Custo Atual</span>
                                        <span id="cost-current-value" class="text-white font-mono font-bold">R$ 410.000</span>
                                    </div>
                                    <div class="w-full bg-gray-800 rounded h-2 relative">
                                        <div class="absolute left-0 top-0 bottom-0 bg-gray-500 rounded w-full transition-all duration-500"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex justify-between text-xs mb-1">
                                        <span class="text-emerald-400 font-medium">Custo Lítio EFX</span>
                                        <span id="cost-lithium-value" class="text-white font-mono font-bold">R$ 65.000</span>
                                    </div>
                                    <div class="w-full bg-gray-800 rounded h-2 relative shadow-[0_0_20px_-5px_rgba(16,185,129,0.3)]">
                                        <div id="cost-lithium-bar" class="absolute left-0 top-0 bottom-0 bg-emerald-500 rounded w-[16%] transition-all duration-500"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Full Width CTA Button Section -->
    <div class="mt-12 w-full max-w-4xl mx-auto px-4 animate-fade-in-up delay-300">
        <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-white mb-2">Quer ver os números exatos?</h3>
            <p class="text-gray-400 max-w-2xl mx-auto">
                Baixe o relatório técnico completo abaixo para ver o cronograma de retorno do investimento.
            </p>
            <div class="animate-bounce mt-4 text-emerald-500">
                <span class="material-symbols-outlined text-3xl">keyboard_arrow_down</span>
            </div>
        </div>
        <button id="open-modal-btn" class="w-full group bg-gradient-to-r from-primary to-primary-dark hover:to-red-700 text-white p-6 rounded-xl shadow-2xl hover:shadow-[0_0_40px_-10px_rgba(237,28,36,0.6)] transition-all duration-300 flex items-center justify-between border border-primary/50 transform hover:-translate-y-1">
            <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 text-left">
                <div class="bg-white/20 p-3 rounded-lg backdrop-blur-sm">
                    <span class="material-symbols-outlined text-white text-2xl">description</span>
                </div>
                <div>
                    <div class="text-lg md:text-xl font-bold uppercase tracking-wide text-white">Baixar Estudo de Viabilidade Completo (PDF)</div>
                    <div class="text-sm text-red-100 font-light opacity-90">Inclui Payback, Plano de Manutenção e Comparativo Fiscal</div>
                </div>
            </div>
            <div class="bg-black/20 rounded-full p-3 group-hover:bg-black/40 transition-colors">
                <span class="material-symbols-outlined text-white transform group-hover:translate-x-1 transition-transform text-2xl">arrow_forward</span>
            </div>
        </button>
        <p class="text-xs text-gray-500 text-center mt-3">
            *O relatório demonstra a eliminação de R$ <span id="periculosidade-val">84.000</span>/ano em periculosidade + custos ocultos.
        </p>
    </div>

    <!-- Lead Capture Modal -->
    <div id="lead-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
        <!-- Backdrop -->
        <div id="modal-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-md opacity-0 transition-opacity duration-300"></div>

        <!-- Modal Content -->
        <div class="relative z-10 w-full max-w-lg mx-4 bg-[#1a1a1a] border border-white/10 rounded-2xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="modal-content">
            
            <!-- Close Button -->
            <button id="close-modal-btn" class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors z-20">
                <span class="material-symbols-outlined">close</span>
            </button>

            <!-- Form State -->
            <div id="modal-form-state" class="p-8">
                <div class="text-center mb-8">
                    <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-3xl text-primary">assignment_turned_in</span>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2">Para onde enviamos seu relatório?</h3>
                    <p class="text-sm text-gray-400">
                        O PDF detalhado inclui Payback mês a mês, plano de manutenção e impacto da periculosidade.
                    </p>
                </div>

                <form id="lead-form" class="space-y-4">
                    <div>
                        <label for="name" class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1.5">Nome</label>
                        <input type="text" id="name" name="name" required placeholder="Seu nome" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                    </div>
                    
                    <div>
                        <label for="email" class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1.5">E-mail Corporativo</label>
                        <input type="email" id="email" name="email" required placeholder="empresa@email.com.br" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                    </div>

                    <div>
                        <label for="whatsapp" class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1.5">WhatsApp</label>
                        <input type="tel" id="whatsapp" name="whatsapp" required placeholder="(00) 00000-0000" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                    </div>

                    <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 rounded-lg shadow-lg hover:shadow-[0_0_20px_-5px_rgba(237,28,36,0.6)] transition-all transform hover:-translate-y-0.5 mt-2 flex items-center justify-center gap-2">
                        <span>GERAR MEU PDF AGORA</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                    
                    <p class="text-[10px] text-center text-gray-500 mt-4">
                        <span class="material-symbols-outlined text-[12px] align-text-bottom mr-1">lock</span>
                        Seus dados estão seguros. Não enviamos spam.
                    </p>
                </form>

                <!-- Value Props (Inside Modal for higher conversion) -->
                <div class="mt-8 pt-6 border-t border-white/5 grid grid-cols-2 gap-4">
                    <div class="flex items-start gap-2">
                         <span class="material-symbols-outlined text-emerald-500 text-lg">calendar_month</span>
                         <div class="text-xs text-gray-400"><strong class="text-white block mb-0.5">Payback Real</strong>Cronograma mês a mês</div>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-emerald-500 text-lg">build</span>
                        <div class="text-xs text-gray-400"><strong class="text-white block mb-0.5">Manutenção Zero</strong>Comparativo de peças</div>
                   </div>
                   <div class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-emerald-500 text-lg">gavel</span>
                        <div class="text-xs text-gray-400"><strong class="text-white block mb-0.5">-30% Periculosidade</strong>Fim do adicional</div>
                   </div>
                   <div class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-emerald-500 text-lg">battery_charging_full</span>
                        <div class="text-xs text-gray-400"><strong class="text-white block mb-0.5">100% Performance</strong>Sem queda de força</div>
                   </div>
                </div>
            </div>

            <!-- Success State -->
            <div id="modal-success-state" class="p-12 hidden flex flex-col items-center justify-center text-center h-full min-h-[500px]">
                <div class="w-20 h-20 bg-emerald-500/20 rounded-full flex items-center justify-center mb-6 animate-pulse">
                    <span class="material-symbols-outlined text-5xl text-emerald-500">check_circle</span>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">Sucesso!</h3>
                <p class="text-gray-300 max-w-xs mx-auto mb-8">
                    Seu relatório está sendo processado. Em menos de 2 minutos, ele chegará no seu WhatsApp e E-mail.
                </p>
                <div class="w-full bg-gray-800 rounded-full h-1.5 overflow-hidden max-w-[200px]">
                     <div class="bg-emerald-500 h-full rounded-full animate-[progress_2s_ease-in-out_infinite]" style="width: 50%"></div>
                </div>
                <p class="text-xs text-gray-500 mt-2">Enviando solicitação...</p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Custom Styles if needed, most are Utility classes */
</style>

<script is:inline>
    // Configurações e Constantes de Custo (Valores Mensais por Máquina em 1 Turno)
    const COSTS = {
        diesel: { fuel: 1851.52, maintenance: 1089.79, label: 'Diesel' },
        glp: { fuel: 3465.00, maintenance: 1241.88, label: 'GLP' },
        lithium: { fuel: 554.40, maintenance: 815.29, label: 'Lítio EFX' } 
    };

    // Estado da Calculadora
    let state = {
        fuel: 'diesel',
        qty: 10,
        shift: 1
    };

    // Inicialização
    document.addEventListener('DOMContentLoaded', () => {
        calculate(); // Calcular inicial
        setupListeners();
    });

    function setupListeners() {
        // Seletores de Combustível
        document.querySelectorAll('.fuel-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.currentTarget;
                state.fuel = target.dataset.fuel;
                updateActiveState('.fuel-btn', target);
                
                // Estilo específico para fuel (active adiciona borda/bg)
                document.querySelectorAll('.fuel-btn').forEach(b => {
                    if(b === target) {
                        b.classList.add('bg-white/10', 'text-white', 'border-white/5');
                        b.classList.remove('text-gray-400', 'hover:text-white', 'border-transparent');
                    } else {
                        b.classList.remove('bg-white/10', 'text-white', 'border-white/5');
                        b.classList.add('text-gray-400', 'hover:text-white', 'border-transparent');
                    }
                });
                
                calculate();
            });
        });

        // Stepper - Minus
        const minusBtn = document.getElementById('qty-minus');
        if(minusBtn) {
            minusBtn.addEventListener('click', () => {
                if(state.qty > 1) {
                    state.qty--;
                    updateQtyUI();
                    calculate();
                }
            });
        }

        // Stepper - Plus
        const plusBtn = document.getElementById('qty-plus');
        if(plusBtn) {
            plusBtn.addEventListener('click', () => {
                state.qty++;
                updateQtyUI();
                calculate();
            });
        }

        // Seletores de Quantidade (Presets)
        document.querySelectorAll('.qty-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.currentTarget;
                state.qty = parseInt(target.dataset.qty);
                
                updateQtyUI();
                calculate();
            });
        });

        // Seletores de Turno
        document.querySelectorAll('.shift-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.currentTarget;
                state.shift = parseInt(target.dataset.shift);

                // Resetar todos
                document.querySelectorAll('.shift-btn').forEach(b => {
                    const title = b.querySelector('span:first-child');
                    
                    b.classList.remove('active', 'bg-emerald-500/10', 'border-emerald-500', 'text-white');
                    b.classList.add('text-gray-400', 'bg-white/5', 'border-white/10');
                    
                    if(title) {
                        title.classList.remove('text-emerald-400');
                        title.classList.add('text-gray-500');
                    }
                });

                // Ativar atual
                target.classList.remove('text-gray-400', 'bg-white/5', 'border-white/10');
                target.classList.add('active', 'bg-emerald-500/10', 'border-emerald-500', 'text-white');
                
                const activeTitle = target.querySelector('span:first-child');
                if(activeTitle) {
                    activeTitle.classList.remove('text-gray-500');
                    activeTitle.classList.add('text-emerald-400');
                }

                calculate();
            });
        });

        setupModal();
    }

    function setupModal() {
        const modal = document.getElementById('lead-modal');
        const openBtn = document.getElementById('open-modal-btn');
        const closeBtn = document.getElementById('close-modal-btn');
        const backdrop = document.getElementById('modal-backdrop');
        const modalContent = document.getElementById('modal-content');
        const form = document.getElementById('lead-form');
        const formState = document.getElementById('modal-form-state');
        const successState = document.getElementById('modal-success-state');

        function openModal() {
            modal.classList.remove('hidden');
            // Timeout to allow display:block to apply before opacity transition
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                modalContent.classList.remove('opacity-0', 'scale-95');
                modalContent.classList.add('scale-100');
            }, 10);
        }

        function closeModal() {
            backdrop.classList.add('opacity-0');
            modalContent.classList.add('opacity-0', 'scale-95');
            modalContent.classList.remove('scale-100');
            
            setTimeout(() => {
                modal.classList.add('hidden');
                // Reset form state on close after delay
                setTimeout(() => {
                    formState.classList.remove('hidden');
                    successState.classList.add('hidden');
                    successState.classList.remove('flex');
                    form.reset();
                }, 200);
            }, 300);
        }

        if(openBtn) openBtn.addEventListener('click', openModal);
        if(closeBtn) closeBtn.addEventListener('click', closeModal);
        if(backdrop) backdrop.addEventListener('click', closeModal);

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeModal();
            }
        });

        // Form Submit
        if(form) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                
                // Collect data (for future backend integration)
                const formData = new FormData(form);
                const data = Object.fromEntries(formData);
                console.log('Lead Captured:', data);

                // Show Success State
                formState.classList.add('hidden');
                successState.classList.remove('hidden');
                successState.classList.add('flex');

                // Auto Close after 3 seconds (optional, but good UX if message says "sent")
                // For now, let user close it or read it.
            });
        }
    }

    function calculate() {
        const currentData = COSTS[state.fuel];
        const lithiumData = COSTS.lithium;

        const currentCostBase = currentData.fuel + currentData.maintenance;
        const lithiumCostBase = lithiumData.fuel + lithiumData.maintenance;

        // Fator de multiplicação por turno (1x, 2x, 3x)
        const shiftMultiplier = state.shift; 

        // Custo Mensal Total Atual
        const currentMonthlyCost = currentCostBase * state.qty * shiftMultiplier;
        const currentAnnualCost = currentMonthlyCost * 12;

        // Custo Mensal Total Lítio
        const lithiumMonthlyCost = lithiumCostBase * state.qty * shiftMultiplier;
        const lithiumAnnualCost = lithiumMonthlyCost * 12;

        // Economia
        const annualSavings = currentAnnualCost - lithiumAnnualCost;
        const savingsPercentage = Math.round(((currentAnnualCost - lithiumAnnualCost) / currentAnnualCost) * 100);
        const projection5Years = annualSavings * 5;

        // Atualizar DOM
        
        // 1. Valores Principais
        updateText('annual-savings', '± ' + formatCurrency(annualSavings));
        updateText('projection-5y', formatCurrency(projection5Years));
        
        // 2. Badges e Labels
        updateText('efficiency-badge', `+${savingsPercentage}% Eficiência`);
        
        const fuelLabel = COSTS[state.fuel].label;
        const shiftLabel = state.shift === 3 ? '18h' : (state.shift === 2 ? '12h' : '6h');
        updateText('comparison-label', `vs. ${fuelLabel} (${state.qty} un / ${shiftLabel})`);

        // 3. Barras de Custo Comparativo (Ano 1)
        updateText('cost-current-value', formatCurrency(currentAnnualCost));
        updateText('cost-lithium-value', formatCurrency(lithiumAnnualCost));

        // Calcular largura da barra de lítio relativa ao custo atual (que é sempre 100% da barra cheia visualmente)
        // Se custo atual é 100%, quanto é o lítio?
        const lithiumBarWidth = Math.max(5, Math.round((lithiumAnnualCost / currentAnnualCost) * 100));
        
        const lithiumBar = document.getElementById('cost-lithium-bar');
        if(lithiumBar) lithiumBar.style.width = `${lithiumBarWidth}%`;

        // Barra de projeção (visual only, keep high)
        const projectionBar = document.getElementById('projection-bar');
        if(projectionBar) projectionBar.style.width = `${savingsPercentage}%`;
    }

    function updateActiveState(selector, activeElement) {
        // Lógica simplificada de toggle classe active
    }

    function updateText(id, text) {
        const el = document.getElementById(id);
        if(el) el.textContent = text;
    }

    function updateQtyUI() {
        // Atualiza display numérico
        updateText('qty-display', state.qty);

        // Atualiza estado dos presets
        document.querySelectorAll('.qty-btn').forEach(b => {
            const btnQty = parseInt(b.dataset.qty);
            if(btnQty === state.qty) {
                b.classList.remove('border-white/10', 'bg-white/5', 'text-gray-400');
                b.classList.add('active', 'border-primary', 'bg-primary/20', 'text-white', 'shadow-[0_0_5px_rgba(237,28,36,0.3)]');
            } else {
                b.classList.remove('active', 'border-primary', 'bg-primary/20', 'text-white', 'shadow-[0_0_5px_rgba(237,28,36,0.3)]');
                b.classList.add('border-white/10', 'bg-white/5', 'text-gray-400');
            }
        });
    }

    function formatCurrency(value) {
        if (value >= 1000000) {
            return (value / 1000000).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumSignificantDigits: 3 }) + ' Mi'; // Ex: R$ 1,72 Mi
        }
        if (value >= 1000) {
            return 'R$ ' + (value / 1000).toLocaleString('pt-BR', { maximumFractionDigits: 0 }) + 'k'; // Ex: R$ 345k
        }
        return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }
</script>
