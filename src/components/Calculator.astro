            doc.roundedRect(c1x, cardsY, card3W, card3H, 2, 2, 'FD');
            doc.setFillColor(16, 185, 129);
            doc.rect(c1x, cardsY, card3W, 1.5, 'F');
            
            doc.setFontSize(5.5);
            doc.setTextColor(16, 185, 129);
            doc.setFont(undefined, 'bold');
            doc.text("PAYBACK DIFERENÇA", c1x + 3, cardsY + 7);
            doc.setFont(undefined, 'normal');
            
            if (paybackDiffMonth >= 0 && paybackDiffMonth <= 60) {
                doc.setFontSize(16);
                doc.setTextColor(5, 122, 85);
                doc.setFont(undefined, 'bold');
                doc.text(`${Math.ceil(paybackDiffMonth)}`, c1x + 3, cardsY + 18);
                doc.setFontSize(8);
                doc.text("meses", c1x + 3 + doc.getTextWidth(`${Math.ceil(paybackDiffMonth)}`) + 2, cardsY + 18);
                doc.setFont(undefined, 'normal');
            } else {
                doc.setFontSize(12);
                doc.setTextColor(5, 122, 85);
                doc.setFont(undefined, 'bold');
                doc.text("Imediato", c1x + 3, cardsY + 18);
                doc.setFont(undefined, 'normal');
            }
            doc.setFontSize(5);
            doc.setTextColor(100, 116, 139);
            doc.text("Investimento extra:", c1x + 3, cardsY + 25);
            const diffValue = totalAcquisitionLithium - totalAcquisitionCurrent;
            doc.setFont(undefined, 'bold');
            doc.text(formatMoney(Math.abs(diffValue)), c1x + 3, cardsY + 30);
            doc.setFont(undefined, 'normal');
            doc.setFontSize(4.5);
            doc.setTextColor(150, 150, 150);
            doc.text(`Economia: ${formatMoney(monthlySavings)}/mês`, c1x + 3, cardsY + 35);

            // Card 2: Payback Total (blue accent)
            const c2x = c1x + card3W + cardGap;
            doc.setDrawColor(59, 130, 246);
            doc.setLineWidth(0.3);
            doc.setFillColor(239, 246, 255);
            doc.roundedRect(c2x, cardsY, card3W, card3H, 2, 2, 'FD');
            doc.setFillColor(59, 130, 246);
            doc.rect(c2x, cardsY, card3W, 1.5, 'F');
            
            doc.setFontSize(5.5);
            doc.setTextColor(59, 130, 246);
            doc.setFont(undefined, 'bold');
            doc.text("PAYBACK TOTAL", c2x + 3, cardsY + 7);
            doc.setFont(undefined, 'normal');
            
            if (paybackTotalMonth > 0 && paybackTotalMonth <= 60) {
                doc.setFontSize(16);
                doc.setTextColor(29, 78, 216);
                doc.setFont(undefined, 'bold');
                doc.text(`${Math.ceil(paybackTotalMonth)}`, c2x + 3, cardsY + 18);
                doc.setFontSize(8);
                doc.text("meses", c2x + 3 + doc.getTextWidth(`${Math.ceil(paybackTotalMonth)}`) + 2, cardsY + 18);
                doc.setFont(undefined, 'normal');
            } else {
                doc.setFontSize(10);
                doc.setTextColor(29, 78, 216);
                doc.setFont(undefined, 'bold');
                doc.text("+60 meses", c2x + 3, cardsY + 18);
                doc.setFont(undefined, 'normal');
            }
            doc.setFontSize(5);
            doc.setTextColor(100, 116, 139);
            doc.text("Valor total investido:", c2x + 3, cardsY + 25);
            doc.setFont(undefined, 'bold');
            doc.text(formatMoney(totalAcquisitionLithium), c2x + 3, cardsY + 30);
            doc.setFont(undefined, 'normal');
            doc.setFontSize(4.5);
            doc.setTextColor(150, 150, 150);
            doc.text(`Economia: ${formatMoney(monthlySavings)}/mês`, c2x + 3, cardsY + 35);

            // Card 3: Economia 5 Anos (dark bg)
            const c3x = c2x + card3W + cardGap;
            doc.setFillColor(...darkColor);
            doc.roundedRect(c3x, cardsY, card3W, card3H, 2, 2, 'F');
            
            doc.setFontSize(5.5);
            doc.setTextColor(...primaryColor);
            doc.setFont(undefined, 'bold');
            doc.text("ECONOMIA 5 ANOS", c3x + 3, cardsY + 7);
            doc.setFont(undefined, 'normal');
            
            doc.setFontSize(13);
            doc.setTextColor(255, 255, 255);
            doc.setFont(undefined, 'bold');
            doc.text(formatMoneyShort(monthlySavings * 60), c3x + 3, cardsY + 18);
            doc.setFont(undefined, 'normal');
            
            doc.setFontSize(5);
            doc.setTextColor(180, 180, 180);
            doc.text("em custos operacionais", c3x + 3, cardsY + 25);
            doc.setFontSize(4.5);
            doc.setTextColor(150, 150, 150);
            doc.text(`${formatMoney(monthlySavings)}/mês × 60`, c3x + 3, cardsY + 30);
            // Benefício extra line
            doc.setTextColor(...primaryColor);
            doc.text("✓ -30% periculosidade (NR-16)", c3x + 3, cardsY + 35);

            // --- Disclaimer ---
            const disclaimerY = cardsY + card3H + 12;
            doc.setDrawColor(230, 230, 230);
            doc.line(20, disclaimerY - 3, 190, disclaimerY - 3);
            doc.setFontSize(6);
            doc.setTextColor(...grayText);
            const disclaimer = "*A análise de Payback considera dois cenários: (1) Payback da Diferença — tempo de retorno do investimento adicional, e (2) Payback Total — tempo para o valor total do equipamento se pagar via economia operacional. Custos projetados para 60 meses. Valores podem variar conforme a intensidade de uso e tarifas locais de energia.";
            const splitDisclaimer = doc.splitTextToSize(disclaimer, 170);
            doc.text(splitDisclaimer, 20, disclaimerY);

            // --- Footer ---
            doc.setDrawColor(230, 230, 230);
            doc.line(20, 282, 190, 282);
            doc.setFontSize(7);
            doc.setTextColor(...darkColor);
            doc.setFont(undefined, 'bold');
            doc.text("SUPRAVEL", 190, 288, { align: 'right' });
            doc.setFont(undefined, 'normal');
            doc.setFontSize(6);
            doc.setTextColor(...grayText);
            doc.text("© 2025 Todos os direitos reservados.", 190, 292, { align: 'right' });

            doc.save(`Supravel_Relatorio_${reportNum}.pdf`);

        } catch (error) {
            console.error("PDF Generation Error:", error);
            alert("Erro ao gerar PDF: " + error.message);
        }
    }


