---
---

<section id="tecnologia" class="relative py-20 px-6 overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute inset-0 bg-grid-pattern opacity-[0.05] bg-[size:40px_40px]"></div>
        <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-emerald-900/10 rounded-full blur-[120px] opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-teal-500/5 rounded-full blur-[150px] opacity-10 translate-x-1/3 translate-y-1/3"></div>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto flex flex-col">
        <!-- Header -->
        <header class="mb-12 text-center md:text-left">

            <h2 class="font-display text-4xl md:text-5xl font-bold tracking-tight mb-4 text-white max-w-4xl">
                Série EFX: Tecnologia de Lítio Removível 80V/150Ah
            </h2>
            <p class="text-white/40 text-lg max-w-2xl font-light">
                Alta performance para ambientes adversos e operações contínuas.
            </p>
        </header>

        <!-- Bento Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-5 auto-rows-[minmax(200px,auto)]">
            
            <!-- Card 1: Carga & Energia (Large) -->
            <div class="col-span-1 lg:col-span-2 glass-card rounded-2xl p-8 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/10 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
                <div class="flex flex-col h-full justify-between relative z-10">
                    <div class="flex items-start justify-between">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="material-symbols-outlined text-emerald-400">battery_charging_full</span>
                            <h3 class="text-lg font-medium text-white tracking-wide">Carga & Energia</h3>
                        </div>
                        <div class="bg-emerald-500/20 text-emerald-300 text-xs px-2 py-1 rounded border border-emerald-500/20 flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">bolt</span> Carga Rápida
                        </div>
                    </div>
                    <div class="flex flex-col md:flex-row items-baseline gap-2 mt-8">
                        <span class="text-6xl md:text-7xl font-bold text-white tracking-tighter">80V</span>
                        <span class="text-4xl md:text-5xl font-light text-white/40 tracking-tighter">/150Ah</span>
                    </div>
                    <div class="mt-6 flex items-center gap-4 text-sm text-white/60">
                        <div class="flex items-center gap-2">
                            <span class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center border border-white/10">
                                <span class="material-symbols-outlined text-emerald-400 text-sm">timer</span>
                            </span>
                            <span>Recarga Total: <strong class="text-white">1-2h</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center border border-white/10">
                                <span class="material-symbols-outlined text-emerald-400 text-sm">electric_bolt</span>
                            </span>
                            <span>Alta Eficiência</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Conveniência Operacional -->
            <div class="col-span-1 lg:col-span-1 glass-card rounded-2xl p-6 relative overflow-hidden group flex flex-col justify-between">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-blue-400">swap_horiz</span>
                    <h3 class="text-base font-medium text-white">Conveniência Operacional</h3>
                </div>
                <div class="flex-grow flex items-center justify-center relative my-4">
                    <div class="relative w-full h-32 border border-dashed border-white/10 rounded-lg flex items-center justify-center bg-white/5">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-16 bg-white/10 rounded border border-white/20 flex items-center justify-center">
                            <span class="material-symbols-outlined text-white/20 text-3xl">forklift</span>
                        </div>
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-14 bg-emerald-500 rounded shadow-[0_0_15px_rgba(16,185,129,0.4)] flex items-center justify-center z-20 transition-transform group-hover:-translate-x-8 duration-700">
                            <span class="material-symbols-outlined text-white text-sm">battery_full</span>
                        </div>
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-14 border border-emerald-500/30 rounded z-0"></div> 
                        <span class="material-symbols-outlined text-emerald-400 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 animate-pulse z-10 text-2xl">arrow_back</span>
                    </div>
                </div>
                <div class="text-center">
                    <p class="text-sm font-semibold text-white">Sistema "Easy-Swap"</p>
                    <p class="text-xs text-white/40 mt-1">Troca lateral rápida de bateria</p>
                </div>
            </div>

            <!-- Card 3: Mecanismo LFP -->
            <div class="col-span-1 lg:col-span-1 glass-card rounded-2xl p-6 relative overflow-hidden group border-b-2 border-emerald-500/30">
                <div class="absolute inset-0 bg-gradient-to-t from-emerald-900/20 to-transparent"></div>
                <div class="relative z-10 h-full flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="material-symbols-outlined text-emerald-400">shield</span>
                            <h3 class="text-base font-medium text-white">Mecanismo LFP</h3>
                        </div>
                        <p class="text-xs text-white/50 leading-relaxed">
                            Química de Fosfato de Ferro Lítio para máxima segurança operacional.
                        </p>
                    </div>
                    <div class="mt-4 space-y-3">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-white/70">Estabilidade Térmica</span>
                            <span class="text-emerald-400 font-bold">Alta</span>
                        </div>
                        <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                            <div class="bg-emerald-500 h-full w-[95%] shadow-[0_0_8px_rgba(16,185,129,0.6)]"></div>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-white/70">Risco de Incêndio</span>
                            <span class="text-emerald-400 font-bold">Nulo</span>
                        </div>
                        <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                            <div class="bg-emerald-500 h-full w-[100%] shadow-[0_0_8px_rgba(16,185,129,0.6)]"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 4: Inteligência BMS (Large) -->
            <div class="col-span-1 lg:col-span-2 glass-card rounded-2xl p-6 relative overflow-hidden">
                <div class="flex flex-col h-full justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-purple-400">hub</span>
                            <h3 class="text-lg font-medium text-white">Inteligência BMS</h3>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-white/40 uppercase tracking-wide">Saída</p>
                            <p class="text-lg font-bold text-white">100% Potência Constante</p>
                        </div>
                    </div>
                    <div class="relative h-40 w-full mt-2 border-l border-b border-white/10">
                        <svg class="absolute inset-0 h-full w-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 100 100">
                            <line class="stroke-white/5" stroke-dasharray="2" stroke-width="0.5" x1="0" x2="100" y1="20" y2="20"></line>
                            <line class="stroke-white/5" stroke-dasharray="2" stroke-width="0.5" x1="0" x2="100" y1="50" y2="50"></line>
                            <line class="stroke-white/5" stroke-dasharray="2" stroke-width="0.5" x1="0" x2="100" y1="80" y2="80"></line>
                            
                            <!-- Lead Acid Curve -->
                            <path d="M0,20 C20,25 40,40 60,60 C80,80 100,90 100,95" fill="none" class="stroke-white/20" stroke-dasharray="3" stroke-width="2"></path>
                            
                            <!-- Li-ion Curve -->
                            <path class="line-chart-path" d="M0,20 L95,20 L100,90" fill="none" stroke="#10B981" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"></path>
                            <circle class="fill-background-dark stroke-emerald-400" cx="95" cy="20" r="3" stroke-width="2"></circle>
                        </svg>
                        
                        <!-- HTML Overlay Labels (Non-distorted) -->
                        <div class="absolute inset-0 pointer-events-none">
                            <span class="absolute top-[60%] left-[55%] text-[10px] text-white/90 font-bold drop-shadow-md -translate-x-1/2">
                                Chumbo-Ácido
                            </span>
                            <span class="absolute top-[5%] left-[50%] text-[10px] text-emerald-400 font-bold drop-shadow-md -translate-x-1/2">
                                Lítio-Íon
                            </span>
                        </div>
                    </div>
                    <div class="flex justify-between text-xs text-white/30 mt-2">
                        <span>Início Turno</span>
                        <span>Fim Turno</span>
                    </div>
                </div>
            </div>

            <!-- Card 5: Zero Manutenção -->
            <div class="col-span-1 lg:col-span-1 glass-card rounded-2xl p-6 flex flex-col justify-center items-center text-center group hover:bg-white/5 transition-colors">
                <div class="relative w-16 h-16 mb-4">
                    <span class="material-symbols-outlined text-4xl text-white/20 absolute inset-0 flex items-center justify-center">water_drop</span>
                    <span class="material-symbols-outlined text-6xl text-red-500/80 absolute inset-0 flex items-center justify-center animate-ping opacity-20">block</span>
                    <span class="material-symbols-outlined text-6xl text-white absolute inset-0 flex items-center justify-center" style="font-variation-settings: 'wght' 200;">block</span>
                </div>
                <h3 class="text-base font-medium text-white mb-1">Zero Manutenção</h3>
                <p class="text-xs text-white/50">Sem água. Sem ácido. Sem corrosão.</p>
            </div>

            <!-- Card 6: Durabilidade -->
            <div class="col-span-1 lg:col-span-1 glass-card rounded-2xl p-6 relative overflow-hidden flex flex-col justify-between">
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-teal-500/20 rounded-full blur-2xl"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-teal-400">verified</span>
                        <h3 class="text-base font-medium text-white">Durabilidade</h3>
                    </div>
                </div>
                <div class="mt-4 space-y-4 relative z-10">
                    <div>
                        <p class="text-3xl font-bold text-white">4.000+</p>
                        <p class="text-xs text-teal-400 uppercase tracking-widest font-semibold">Ciclos</p>
                    </div>
                    <div class="w-full h-px bg-white/10"></div>
                    <div>
                        <p class="text-3xl font-bold text-white">10+ Anos</p>
                        <p class="text-xs text-teal-400 uppercase tracking-widest font-semibold">Vida Útil</p>
                    </div>
                </div>
            </div>

            <!-- Card 7: Diferencial Ambiental (Large) -->
            <div class="col-span-1 lg:col-span-4 lg:row-span-1 glass-card rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-emerald-900/10 via-transparent to-transparent"></div>
                <div class="flex items-center gap-4 relative z-10">
                    <div class="w-12 h-12 bg-emerald-500/10 rounded-full flex items-center justify-center border border-emerald-500/20">
                        <span class="material-symbols-outlined text-emerald-400">eco</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-medium text-white">Diferencial Ambiental</h3>
                        <p class="text-sm text-white/50">Sustentabilidade integrada à operação logística.</p>
                    </div>
                </div>
                <div class="flex items-center gap-8 relative z-10">
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">98%</p>
                        <p class="text-xs text-emerald-400/80 uppercase">Eficiência</p>
                    </div>
                    <div class="h-8 w-px bg-white/10"></div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">0%</p>
                        <p class="text-xs text-emerald-400/80 uppercase">Emissões</p>
                    </div>
                    <div class="h-8 w-px bg-white/10"></div>
                    <div class="flex items-center gap-2 px-4 py-2 bg-emerald-500/10 rounded-lg border border-emerald-500/20">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"></span>
                        <span class="text-sm font-medium text-emerald-100">Lítio Verde</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Tech Specs Detail Strip -->
        <div class="mt-8 border-t border-white/5 pt-8">
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                <div class="flex flex-col items-center md:items-start border-r border-white/5 last:border-0 px-2 md:px-4">
                    <span class="text-[10px] text-white/30 uppercase tracking-widest mb-1">Voltagem</span>
                    <span class="text-sm font-medium text-white">80V</span>
                </div>
                <div class="flex flex-col items-center md:items-start border-r border-white/5 last:border-0 px-2 md:px-4">
                    <span class="text-[10px] text-white/30 uppercase tracking-widest mb-1">Capacidade</span>
                    <span class="text-sm font-medium text-white">150Ah</span>
                </div>
                <div class="flex flex-col items-center md:items-start border-r border-white/5 last:border-0 px-2 md:px-4">
                    <span class="text-[10px] text-white/30 uppercase tracking-widest mb-1">Troca</span>
                    <span class="text-sm font-medium text-white">Lateral</span>
                </div>
                <div class="flex flex-col items-center md:items-start border-r border-white/5 last:border-0 px-2 md:px-4">
                    <span class="text-[10px] text-white/30 uppercase tracking-widest mb-1">Resistência</span>
                    <span class="text-sm font-medium text-white">Ambientes Severos</span>
                </div>
                <div class="flex flex-col items-center md:items-start px-2 md:px-4">
                    <span class="text-[10px] text-white/30 uppercase tracking-widest mb-1">Ciclos</span>
                    <span class="text-sm font-medium text-emerald-400">4.000+</span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .glass-card {
        background: rgba(20, 20, 20, 0.4);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }
    .glass-card:hover {
        border-color: rgba(255, 255, 255, 0.15);
        background: rgba(30, 30, 30, 0.5);
    }
    
    .line-chart-path {
        stroke-dasharray: 1000;
        stroke-dashoffset: 0;
        animation: draw 2s ease-out forwards;
    }

    /* Animation trigger when in view would require JS, simplifying for now */
    @keyframes draw {
        from { stroke-dashoffset: 1000; }
        to { stroke-dashoffset: 0; }
    }
</style>
